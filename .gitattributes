*.shader text eol=lf
*.hlsl text eol=lf
*.compute text eol=lf
# Pixel-art sprites and Aseprite sources are small: regular Git keeps their history diffable by tools.
*.png binary
*.jpg binary
*.jpeg binary
*.aseprite binary
*.ase binary

# Large sources and media go to Git LFS before their first commit.
*.psd filter=lfs diff=lfs merge=lfs -text
*.psb filter=lfs diff=lfs merge=lfs -text
*.kra filter=lfs diff=lfs merge=lfs -text
